<Window x:Class="QuantumOverdrive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quantum Overdrive" Height="820" Width="1280" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E121A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                        <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="Q" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="QUANTUM" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="OVERDRIVE" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,12" />
                    <Button x:Name="DashboardNav" Content="  ◈    Dashboard" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="DashboardNav_Click" Background="#25203B" BorderBrush="#514189" />
                    <Button x:Name="BoosterNav" Content="  ⚡    Game booster" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="BoosterNav_Click" />
                    <Button x:Name="LibraryNav" Content="  ▣    Game library" HorizontalContentAlignment="Left" Margin="0,0,0,7" Click="LibraryNav_Click" />
                    <Button x:Name="SettingsNav" Content="  ⚙    Settings" HorizontalContentAlignment="Left" Click="SettingsNav_Click" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="SYSTEM STATUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="Monitoring active" FontSize="12" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="LastUpdatedText" Text="Waiting for readings…" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Performance overview" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Your hardware, at a glance. Updates automatically every second." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#14251F" BorderBrush="#245342" BorderThickness="1" CornerRadius="20" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" VerticalAlignment="Center" />
                            <TextBlock Text=" LIVE" Foreground="{StaticResource MintBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ClockText" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DashboardPage" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="145" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="142" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,18">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="CPU LOAD" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="  ●" Foreground="{StaticResource AccentBrush}" FontSize="8" VerticalAlignment="Center" /></StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CpuUsageText" Text="--" FontSize="31" FontWeight="SemiBold" /><TextBlock Text=" %" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel>
                            <TextBlock x:Name="CpuNameText" Grid.Row="2" Text="Processor usage" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="GPU LOAD" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="  ●" Foreground="{StaticResource MintBrush}" FontSize="8" VerticalAlignment="Center" /></StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="GpuUsageText" Text="--" FontSize="31" FontWeight="SemiBold" /><TextBlock Text=" %" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel>
                            <TextBlock x:Name="GpuNameText" Grid.Row="2" Text="3D engine utilization" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="MEMORY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="MemoryUsageText" Text="--" FontSize="29" FontWeight="SemiBold" /><TextBlock Text=" %" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel>
                            <TextBlock x:Name="MemoryDetailText" Grid.Row="2" Text="-- / -- GB used" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="CPU TEMPERATURE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CpuTemperatureText" Text="--" FontSize="29" FontWeight="SemiBold" /><TextBlock Text=" °C" Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Bottom" Margin="3,0,0,5" /></StackPanel>
                            <TextBlock x:Name="TemperatureSourceText" Grid.Row="2" Text="Sensor availability varies" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <StackPanel><TextBlock Text="Live performance" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="CPU and GPU utilization · last 60 seconds" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" /><TextBlock Text=" CPU" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,0,15,0" />
                                <Ellipse Width="8" Height="8" Fill="{StaticResource MintBrush}" /><TextBlock Text=" GPU" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="5,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="ChartCanvas" Grid.Row="1" ClipToBounds="True" Margin="0,15,0,8" SizeChanged="ChartCanvas_SizeChanged">
                            <Polyline x:Name="CpuChartLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5" />
                            <Polyline x:Name="GpuChartLine" Stroke="{StaticResource MintBrush}" StrokeThickness="2.5" />
                        </Canvas>
                        <Grid Grid.Row="2">
                            <TextBlock Text="60s ago" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBlock Text="Now" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <StackPanel><TextBlock Text="Quick actions" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Get ready for your next session" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,12" /></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="⚡  Game booster" Style="{StaticResource AccentButton}" Click="BoosterNav_Click" Margin="0,0,8,0" />
                                <Button Content="＋  Add a game" Click="AddGame_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16">
                        <Grid>
                            <StackPanel><TextBlock Text="Memory in use" FontSize="14" FontWeight="SemiBold" /><TextBlock x:Name="MemoryBarLabel" Text="Waiting for memory data…" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0" /></StackPanel>
                            <ProgressBar x:Name="MemoryProgress" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Bottom" Background="#252D3C" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="BoosterPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="One-click gaming setup" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Switch to a performance power plan and enable Windows Game Mode. These are reversible Windows settings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18" />
                            <WrapPanel>
                                <Button Content="⚡  Apply gaming setup" Style="{StaticResource AccentButton}" Click="ApplyGamingSetup_Click" Margin="0,0,10,10" />
                                <Button Content="↩  Restore Balanced plan" Click="RestoreBalanced_Click" Margin="0,0,10,10" />
                                <Button Content="Open Windows Game Mode" Click="OpenGameMode_Click" Margin="0,0,10,10" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Launch and prioritize a game" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a game executable, launch it, then optionally raise its process priority while it is running." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,17" />
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="GamePathBox" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="Path to a game .exe" />
                                    <Button Grid.Column="1" Content="Browse…" Click="BrowseGame_Click" Margin="9,0,0,0" />
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Preferred GPU" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="GraphicsPreferenceCombo" Width="190" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Let Windows decide" Tag="default" IsSelected="True" />
                                        <ComboBoxItem Content="Power saving GPU" Tag="1" />
                                        <ComboBoxItem Content="High performance GPU" Tag="2" />
                                    </ComboBox>
                                    <Button Content="Apply for this game" Click="ApplyGpuPreference_Click" Margin="9,0,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Button Content="Launch game" Style="{StaticResource AccentButton}" Click="LaunchGame_Click" Margin="0,0,9,0" />
                                    <Button Content="Windows graphics settings…" Click="OpenGraphicsSettings_Click" />
                                </WrapPanel>
                            </Grid>
                            <CheckBox x:Name="HighPriorityCheck" Content="Set game process to Above normal priority after launch" Foreground="{StaticResource MutedBrush}" Margin="1,14,0,0" IsChecked="True" />
                            <TextBlock Text="Windows applies GPU preferences when the game starts and may override them. Use Windows graphics settings to choose a specific adapter." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#191721" BorderBrush="#463E65" BorderThickness="1" CornerRadius="12" Padding="16">
                        <TextBlock Text="Safety note: Quantum Overdrive does not overclock components, disable security services, or kill background processes. Hardware tuning can damage components; use manufacturer tools for supported tuning." TextWrapping="Wrap" Foreground="#C1B8E8" FontSize="12" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LibraryPage" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Add your installed games for quick access." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <Button Content="＋  Add game" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="AddGame_Click" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GameList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,0,10">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                        <Button Content="Launch" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="{Binding Path}" Click="LaunchLibraryGame_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Monitoring" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Choose how often hardware usage is refreshed." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,16" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Update interval" VerticalAlignment="Center" Margin="0,0,15,0" />
                                <ComboBox x:Name="IntervalCombo" Width="140">
                                    <ComboBoxItem Content="1 second" Tag="1" IsSelected="True" />
                                    <ComboBoxItem Content="2 seconds" Tag="2" />
                                    <ComboBoxItem Content="5 seconds" Tag="5" />
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Text="CPU temperature and GPU readings depend on hardware sensor and driver support. Unsupported readings appear as unavailable." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,15,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Detected graphics adapters" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Hardware names and live sensor readings detected by LibreHardwareMonitor." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
                            <ItemsControl x:Name="GpuDevicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#101620" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LoadText}" Foreground="{StaticResource MintBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding TemperatureText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="GpuDetectionHint" Text="Waiting for the first hardware sensor scan…" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <Button Content="Open Windows graphics settings…" HorizontalAlignment="Left" Click="OpenGraphicsSettings_Click" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="22">
                        <StackPanel>
                            <TextBlock Text="About Quantum Overdrive" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="A lightweight gaming PC monitor and setup tool. No telemetry leaves your PC; readings are collected locally." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="0,15,0,0" Background="#111721" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11,8">
                <TextBlock x:Name="NotificationText" Text="Ready · Hardware telemetry runs locally on this PC." Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
